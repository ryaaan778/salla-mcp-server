/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "salla-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"migrations": [
		{
			"new_sqlite_classes": [
  "SallaMCP"
]
			],
			"tag": "v1"
		}
	,
	"durable_objects": {{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salla-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [{"new_sqlite_classes": ["SallaMCP"], "tag": "v1"}],
  "durable_objects": {"bindings": [{"class_name": "SallaMCP", "name": "MCP_OBJECT"}]},
  "kv_namespaces": [
    {"binding": "OAUTH_KV", "id": "8f18b83e5a9b4497ea0f164c53d84f511"},
    {"binding": "TOKENS", "id": "7819b25651744c2fbc8d8af6cc33b07e"}
  ],
  "observability": {"enabled": true},
  "vars": {
    "SALLA_CLIENT_ID": "bd955454-096e-4ddf-9295-c789394575e3",
    "SALLA_BASE_URL": "https://api.salla.dev/admin/v2",
    "SALLA_AUTH_URL": "https://accounts.salla.sa/oauth2/auth",
    "SALLA_TOKEN_URL": "https://accounts.salla.sa/oauth2/token",
    "WORKER_URL": "REPLACE_AFTER_FIRST_DEPLOY"
  }
}

		"bindings": [
			{
				"class_name": "SallaMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
    "kv_namespaces": [
        {
            "binding": "OAUTH_KV",
            "id": "8f18b83e5a9b4497ea0f164c53d84f511",
        },
        {
            "binding": "TOKENS",
            "id": "7819b25651744c2fbc8d8af6cc33b07e",
        }
    ],
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	 "vars": {
        "SALLA_CLIENT_ID": "bd955454-096e-4ddf-9295-c789394575e3",
        "SALLA_BASE_URL": "https://api.salla.dev/admin/v2",
        "SALLA_AUTH_URL": "https://accounts.salla.sa/oauth2/auth",
        "SALLA_TOKEN_URL": "https://accounts.salla.sa/oauth2/token",
        "WORKER_URL": "REPLACE_AFTER_FIRST_DEPLOY"
    },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
